{
  "name": "devlink",
  "version": "0.0.0",
  "private": true,
  "description": "Test unreleased npm libraries in real consumer apps through a local registry.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devlink": "./dist/devlink.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "semver": "^7.8.6",
    "verdaccio": "^6.11.2"
  }
}
