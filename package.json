{
  "name": "devlink-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:all": "npm run test:all --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
