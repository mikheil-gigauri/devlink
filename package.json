{
  "name": "devlink-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:all": "npm run test:all --workspaces --if-present",
    "menubar:test": "cd apps/menubar && xcrun swift test",
    "menubar:e2e": "npm run build && apps/menubar/scripts/e2e.sh",
    "menubar:bundle": "apps/menubar/scripts/bundle.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
